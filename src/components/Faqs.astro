---
import en from '../i18n/messages/en.json';
import es from '../i18n/messages/es.json';

const lang = Astro.url.pathname.includes('/es') ? 'es' : 'en';
const t = lang === 'es' ? es : en;

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items?: FaqItem[];
  title?: string;
  subtitle?: string;
  idPrefix?: string;
}

const { items: itemsProp, title: titleProp, subtitle: subtitleProp, idPrefix = 'faq' } = Astro.props;

const faqs = itemsProp ?? t.faqs.items;
const heading = titleProp ?? t.faqs.title;
const subheading =
  subtitleProp !== undefined ? subtitleProp : t.faqs.subtitle;
---

<section class="bg-pearl py-20 md:py-32" id="faqs">
  <div class="max-w-screen-xl mx-auto px-6 md:px-12">
    <div data-aos="fade-up" class="text-center mb-16 md:mb-20">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-main text-taupe mb-3 tracking-tight">{heading}</h2>
      <div class="flex items-center justify-center gap-4 text-dusty text-xl mb-6">
        <span>•</span><span>•</span><span>•</span>
      </div>
      {subheading ? (
        <p class="text-lg md:text-xl text-taupe/60 font-light">{subheading}</p>
      ) : null}
    </div>

    <div class="max-w-2xl mx-auto">
      <div class="space-y-4">
        {faqs.map((faq: FaqItem, index: number) => (
          <div
            class="bg-white px-8"
            data-accordion="collapse"
            data-active-classes="bg-white text-taupe border-b-2 border-blush"
            data-inactive-classes="text-taupe"
          >
            <h3 id={`${idPrefix}-heading-${index}`}>
              <button
                type="button"
                class="flex items-center justify-between w-full min-h-[72px] py-4 font-medium text-left text-taupe"
                data-accordion-target={`#${idPrefix}-body-${index}`}
                aria-expanded="false"
                aria-controls={`${idPrefix}-body-${index}`}
              >
                <span class="w-full text-taupe">{faq.question}</span>
                <svg data-accordion-icon class="w-6 h-6 text-taupe rotate-180 flex-shrink-0" aria-hidden="true" width="24" height="24" fill="none" viewBox="0 0 24 24">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m16 14-4-4-4 4" />
                </svg>
              </button>
            </h3>
            <div id={`${idPrefix}-body-${index}`} class="hidden" aria-labelledby={`${idPrefix}-heading-${index}`}>
              <div class="pt-2 pb-6">
                {faq.answer}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
