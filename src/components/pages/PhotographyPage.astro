---
import type messages from '../../i18n/messages/en.json';
import { getBasePath, getTranslations } from '../../i18n/utils.js';
import Layout from '../../layouts/Layout.astro';
import Faqs from '../Faqs.astro';
import Footer from '../Footer.astro';
import Navbar from '../Navbar.astro';
import Princing from '../Princing.astro';
import Button from '../shared/Button.astro';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslations(locale) as typeof messages;
const base = getBasePath(locale);
const p = t.photographyPage;
---

<Layout title={p.seo.title} description={p.seo.description}>
  <Navbar />
  <main>
    <!-- A) Hero -->
    <section class="pt-32">
      <div class="max-w-screen-xl mx-auto px-6 md:px-12">
        <header class="text-center">
          <h1 class="text-5xl md:text-7xl font-main text-taupe mb-3 tracking-tight">
            {p.hero.title}
          </h1>
          <div class="flex items-center justify-center gap-4 text-dusty text-xl mb-6">
            <span>•</span><span>•</span><span>•</span>
          </div>
          <p class="text-lg md:text-xl text-taupe/60 font-light max-w-2xl mx-auto">
            {p.hero.subtext}
          </p>
        </header>
      </div>
    </section>

    <!-- B) Photo grid -->
    <section class="bg-white pt-16 pb-20 md:pt-24 md:pb-28">
      <div class="max-w-screen-xl mx-auto px-6 md:px-12">
        <h2 class="sr-only">{p.gallery.heading}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 md:gap-4">
          {p.gallery.images.map((img, i) => (
              <div class="group relative aspect-[3/4] overflow-hidden bg-taupe/5">
                <img
                  src={img.src}
                  alt={img.alt}
                  class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                  loading="lazy"
                  decoding="async"
                  data-aos="fade-up"
                  data-aos-delay={Math.min(i * 40, 200)}
                />
              </div>
          ))}
        </div>
      </div>
    </section>

    <!-- C) Bridge → video -->
    <section class="bg-ivory  py-20 md:py-28">
      <div class="max-w-screen-xl mx-auto px-6 md:px-12 text-center">
        <h2 class="text-2xl md:text-3xl lg:text-4xl font-main font-normal tracking-tight leading-snug max-w-2xl mx-auto">
          {p.bridge.line1}
          <span class="block mt-2">{p.bridge.line2}</span>
        </h2>
        <div class="mt-10 flex justify-center">
          <Button href={`${base}/gallery`} label={p.bridge.cta} variant="primary" size="compact" />
        </div>
      </div>
    </section>

    <!-- D) Pricing — one Photo + Video plan -->
    <Princing
      title={p.pricing.title}
      subtitle={p.pricing.subtitle}
      plans={p.pricing.plans}
      microcopy={p.pricing.microcopy}
      ctaLabel={p.pricing.ctaLabel}
      ctaHref={`${base}/contact`}
    />

    <!-- E) FAQ — same accordion layout as Home -->
    <Faqs items={p.faq.items} title={p.faq.heading} idPrefix="photography-faq" />
  </main>
  <Footer />
</Layout>
