---
import Layout from '../../layouts/Layout.astro';
import { getTranslations } from '../../i18n/utils.js';
import type messages from '../../data/../i18n/messages/en.json';
import About from '../About.astro';
import Faqs from '../Faqs.astro';
import Footer from '../Footer.astro';
import Grid from '../Grid.astro';
import Navbar from '../Navbar.astro';
import PhotographyMicro from '../PhotographyMicro.astro';
import Princing from '../Princing.astro';
import Welcome from '../Welcome.astro';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
---

<Layout title={t.seo.defaultTitle} description={t.seo.defaultDescription}>
	<Navbar/>
	<Welcome/>
	<About/>
	<!-- <Testimonials/> -->
	<Grid/>
	<Princing/>
	<Faqs/>
	<PhotographyMicro />
	<Footer/>
</Layout>
