---
import Button from './shared/Button.astro';
import FilmPreview from './shared/FilmPreview.astro';
import { getLang, getTranslations, getBasePath } from '../i18n/utils.js';
import type messages from '../i18n/messages/en.json';

const lang = getLang(Astro.url);
const t = getTranslations(lang) as typeof messages;
const base = getBasePath(lang);

const projects = t.portfolio.projects;
---

<section class="bg-ivory py-20 md:py-32">
    <div class="max-w-screen-xl mx-auto px-6 md:px-12">
        <div data-aos="fade-up" class="grid grid-cols-2 gap-3 md:gap-4">
            {projects.map((project) => (
                <div class="relative aspect-video overflow-hidden bg-taupe/5">
                    <FilmPreview project={project} class="!absolute inset-0" />
                </div>
            ))}
        </div>

        <div class="text-center mt-12 md:mt-16">
            <Button href={`${base}/gallery`} label={t.grid.cta} variant="primary" />
        </div>
    </div>
</section>

