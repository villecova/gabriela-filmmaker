---
import { getBasePath, getLang, getTranslations } from '../i18n/utils.js';
import Logo from "./shared/Logo.astro";

const lang = getLang(Astro.url);
const t: any = getTranslations(lang);
const base = getBasePath(lang);

const heroMoments = Array.from({ length: 10 }, (_, i) => `/assets/images/hero/moment-${String(i + 1).padStart(2, '0')}.webp`);
---

<section class="relative w-full h-screen overflow-hidden flex items-center justify-center text-center pt-16" id="hero">
  <!-- Momentos de los films (fundido + zoom lento) -->
  <div class="absolute inset-0 z-0" id="hero-moments">
    {heroMoments.map((src, i) => (
      <img
        src={i === 0 ? src : undefined}
        data-src={src}
        alt=""
        fetchpriority={i === 0 ? 'high' : undefined}
        class={`hero-moment ${i === 0 ? 'is-active' : ''}`}
      />
    ))}
  </div>

  <!-- Overlay -->
  <div class="absolute inset-0 bg-taupe bg-opacity-50 z-2"></div>

  <!-- Contenido -->
  <div class="relative z-3 text-white px-6 md:px-12 lg:px-16 max-w-screen-xl mx-auto w-full">
    <div class="max-w-4xl mx-auto flex flex-col items-center">
      <div data-aos="fade-up" data-aos-duration="1000" class="flex flex-col items-center">
        <Logo size="hero" as="h1" invert class="mb-5" />

        <p class="text-xl md:text-2xl lg:text-3xl font-light mb-8 leading-relaxed text-white/90">
          {t.hero.title}
        </p>

        <div class="text-sm md:text-base font-light text-white/75 mb-10 space-y-1">
          {t.hero.description.map((line: string) => (
            line ? <p>{line}</p> : <p class="h-4"></p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-moment {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1);
    transition: opacity 1.6s ease, transform 8s linear;
  }

  .hero-moment.is-active {
    opacity: 1;
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-moment { transition: opacity 1.6s ease; transform: none !important; }
  }
</style>

<script>
  const INTERVAL = 5000;
  const moments = [...document.querySelectorAll<HTMLImageElement>('.hero-moment')];

  // Cargar el resto de momentos cuando la página ya terminó de cargar
  window.addEventListener('load', () => {
    moments.forEach((img) => {
      if (!img.src && img.dataset.src) img.src = img.dataset.src;
    });

    let current = 0;
    setInterval(() => {
      const next = (current + 1) % moments.length;
      if (!moments[next].complete) return;
      moments[current].classList.remove('is-active');
      moments[next].classList.add('is-active');
      current = next;
    }, INTERVAL);
  });
</script>
