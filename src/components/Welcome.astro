---
import { getBasePath, getLang, getTranslations } from '../i18n/utils.js';
import Logo from "./shared/Logo.astro";

const lang = getLang(Astro.url);
const t: any = getTranslations(lang);
const base = getBasePath(lang);
---

<section class="relative w-full h-screen overflow-hidden flex items-center justify-start text-left pt-16" id="hero">
  <!-- Poster de respaldo para evitar gris al cargar -->


  <!-- Video de fondo -->
  <video
    poster="/assets/images/poster/aaron-noreen.png"
    muted
    playsinline
    preload="metadata"
    id="hero-video"
    class="absolute top-0 left-0 w-full h-full object-cover z-0"
    webkit-playsinline
  >
    <source src="/assets/videos/aaron-noreen.mp4" type="video/mp4" />
  </video>

  <!-- Overlay -->
  <div class="absolute inset-0 bg-taupe bg-opacity-50 z-2"></div>

  <!-- Contenido -->
  <div class="relative z-3 text-white px-6 md:px-12 lg:px-16 max-w-screen-xl mx-auto w-full">
    <div class="max-w-2xl">
      <div data-aos="fade-up" data-aos-duration="1000">
        <Logo size="hero" as="h1" class="mb-6" />

        <p class="text-2xl md:text-3xl lg:text-4xl font-light mb-8 leading-relaxed">
          {t.hero.title}
        </p>

        <div class="text-base md:text-lg font-light text-white/80 mb-10 space-y-1">
          {t.hero.description.map((line: string) => (
            line ? <p>{line}</p> : <p class="h-4"></p>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const video = document.getElementById('hero-video');

    const START_TIME = 6;
    const END_TIME = 20;
    const LEAD_TIME = 0.15; // pequeño margen para loop suave

    if (!video) return;

    // Asegurar que no arranca automáticamente mal
    video.pause();

    // Cuando ya tenemos metadata → mover al segundo inicial
    video.addEventListener('loadedmetadata', () => {
      try {
        video.currentTime = START_TIME;
      } catch (e) {
        console.warn('Error setting start time', e);
      }
    });

    // Cuando ya hizo seek → reproducir
    video.addEventListener('seeked', () => {
      if (video.currentTime >= START_TIME) {
        video.play().catch(() => {
          // autoplay puede fallar en algunos contextos
          console.warn('Autoplay blocked');
        });
      }
    });

    // Loop controlado dentro del segmento
    video.addEventListener('timeupdate', () => {
      if (video.currentTime >= END_TIME - LEAD_TIME) {
        video.currentTime = START_TIME;
      }
    });

    // Si hay error → se queda el poster (no hacemos nada)
    video.addEventListener('error', (e) => {
      console.warn('Video error:', e);
    });
  });
</script>
