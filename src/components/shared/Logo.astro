---
interface Props {
  size?: 'small' | 'medium' | 'large' | 'hero';
  as?: 'h1' | 'h2' | 'div' | 'span';
  href?: string;
  class?: string;
  invert?: boolean;
  'data-collapse-toggle'?: string;
  [key: string]: any;
}

const { 
  size = 'medium', 
  as = 'div',
  href,
  class: className = '',
  invert = false,
  'data-collapse-toggle': dataCollapseToggle,
} = Astro.props;

const sizeClasses = {
  small: 'h-9 md:h-11',
  medium: 'h-12 md:h-14',
  large: 'h-20 md:h-28',
  hero: 'h-28 sm:h-40 md:h-48 lg:h-56 max-w-[92vw] md:max-w-3xl',
};

const imgClasses = [
  'w-auto object-contain',
  sizeClasses[size as keyof typeof sizeClasses] || sizeClasses.medium,
  invert ? 'invert' : '',
].filter(Boolean).join(' ');

const Tag = as;
const isLink = href !== undefined;
const wrapperClasses = `inline-flex items-center ${className}`.trim();
---

{isLink ? (
  <a 
    href={href} 
    class={wrapperClasses}
    data-collapse-toggle={dataCollapseToggle}
    aria-label="POLKADOTS Cinema"
  >
    <img
      src="/assets/images/polkadots-logo.png"
      alt="POLKADOTS Cinema"
      class={imgClasses}
    />
  </a>
) : (
  <Tag class={wrapperClasses}>
    <img
      src="/assets/images/polkadots-logo.png"
      alt="POLKADOTS Cinema"
      class={imgClasses}
    />
  </Tag>
)}
