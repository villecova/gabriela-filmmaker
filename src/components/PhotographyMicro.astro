---
import Button from './shared/Button.astro';
import fvPhoto from '../assets/fv.png';
import { getLang, getTranslations, getBasePath } from '../i18n/utils.js';
import type messages from '../i18n/messages/en.json';

const lang = getLang(Astro.url);
const t = getTranslations(lang) as typeof messages;
const base = getBasePath(lang);
const hp = t.homePhotography;
---

<section class="bg-ivory py-20 md:py-32" id="photography" aria-label={hp.headline}>
  <div class="max-w-screen-xl mx-auto px-6 md:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <!-- Texto -->
      <div data-aos="fade-right" class="text-center lg:text-left">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-main mb-3 text-taupe tracking-tight">
          {hp.headline}
        </h2>
        <div class="flex items-center justify-center lg:justify-start gap-4 text-dusty text-xl mb-8">
          <span>•</span><span>•</span><span>•</span>
        </div>
        <p class="text-sm md:text-base leading-relaxed text-taupe/60 font-light mb-8 max-w-xl mx-auto lg:mx-0">
          {hp.body}
        </p>
        <div class="flex justify-center lg:justify-start">
          <Button
            href={`${base}/photography`}
            label={hp.cta}
            variant="primary"
            size="compact"
          />
        </div>
      </div>

      <!-- Un solo encuadre: mismo instante para foto y video -->
      <div
        data-aos="fade-left"
        class="group relative aspect-video w-full overflow-hidden bg-taupe/5"
      >
        <img
          src={fvPhoto.src}
          alt={hp.imageAlt}
          width={fvPhoto.width}
          height={fvPhoto.height}
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>
